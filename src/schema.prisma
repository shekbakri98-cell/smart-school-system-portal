datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   // "Director", "Instructor", "Student", "Parent"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id                Int                @id @default(autoincrement())
  studentId         String             @unique // e.g. "SMS/001"
  name              String
  grade             String             // "12 Natural", "12 Social", etc.
  subject           String             @default("ICT")
  test1             Float              @default(0)
  test2             Float              @default(0)
  assignment        Float              @default(0)
  finalExam         Float              @default(0)
  totalScore        Float              @default(0)
  attendanceRecords AttendanceRecord[]
  financeLedgers    FinanceLedger[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model AttendanceRecord {
  id        Int      @id @default(autoincrement())
  studentId String
  student   Student  @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  date      String   // YYYY-MM-DD format
  status    String   // "Present", "Absent", "Unmarked"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
}

model Exam {
  id             Int            @id @default(autoincrement())
  title          String
  subject        String         @default("ICT")
  grade_section  String         // e.g. "12 Natural"
  questions_count Int            @default(0)
  questions      Json           // Array of questions [{text, a, b, correct}]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model FinanceLedger {
  id             Int      @id @default(autoincrement())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  name           String   // Cached student name or custom description
  fee_type       String   // "Tuition Q1", "Lab Access Asset", etc.
  amount_due     Float
  amount_paid    Float    @default(0)
  payment_status String   // "Paid", "Pending", "Overdue"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
